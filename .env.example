# --- chain -------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PLIMSOLL_REGISTRY=0x0000000000000000000000000000000000000000

# Key used ONLY to submit requestSurvey() after payment settles. It never touches a Hold,
# never signs a Mark, and holds no funds beyond Sepolia gas. Marks are written by the CRE
# Forwarder, not by this key.
GATEWAY_PRIVATE_KEY=0x

# --- policy ------------------------------------------------------------------
# Reject any Chainlink round older than this. Testnet feeds go stale constantly and a demo
# that reads a two-day-old price on camera is worse than one that refuses to answer.
PRICE_MAX_AGE_SECONDS=3600


# --- hold adapter (C3) ------------------------------------------------------------------
# Shared key the Survey enclave presents to /api/hold. Must equal the value behind the CRE
# secret PLIMSOLL_HOLD_KEY (PLIMSOLL_HOLD_KEY_VAR in cre/.env). Any long random string.
PLIMSOLL_HOLD_KEY=

# The secret binding: which wallets are behind which subject. JSON. Server-side only; the
# adapter never returns an address. { "<subjectId>": ["0x...", "0x..."] }
PLIMSOLL_HOLD_WALLETS={"0x61335871890d6e0c866ec4743b63b48d546c6c9d8acac9344c5787fbdec34838":["0xSUBJECT_WALLET"]}
