# --- chain -------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PLIMSOLL_REGISTRY=0x0000000000000000000000000000000000000000

# Key used ONLY to submit requestSurvey() after payment settles. It never touches a Hold,
# never signs a Mark, and holds no funds beyond Sepolia gas. Marks are written by the CRE
# Forwarder, not by this key.
GATEWAY_PRIVATE_KEY=0x

# --- policy ------------------------------------------------------------------
# Reject any Chainlink round older than this. Testnet feeds go stale constantly and a demo
# that reads a two-day-old price on camera is worse than one that refuses to answer.
PRICE_MAX_AGE_SECONDS=3600

PORT=8402
