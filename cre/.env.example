# Copy to `cre/.env` and fill in. `.env` is gitignored and must stay that way.

# Read-only credential for the subject's Hold adapter. Read-only is a hard requirement:
# a Survey observes a balance sheet, it never moves anything.
PLIMSOLL_HOLD_KEY_VAR=

# Sepolia key used only to broadcast the Mark during `--broadcast` simulation. Deployed
# workflows write through the CRE Forwarder and never touch this.
CRE_ETH_PRIVATE_KEY=

# Default target when --target is not passed.
CRE_TARGET=staging-settings
